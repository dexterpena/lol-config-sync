<controls:HexWindow x:Class="LolConfigSync.App.EditorWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LolConfigSync.App.Controls"
                    xmlns:app="clr-namespace:LolConfigSync.App"
                    xmlns:editing="clr-namespace:LolConfigSync.Core.Editing;assembly=LolConfigSync.Core"
                    Title="Edit setup" Width="760" Height="680" MinWidth="620" MinHeight="460"
                    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <app:StringToBoolConverter x:Key="StringToBool" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="28,10,28,22">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Edit your setup" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                       Text="Changes are saved to your main setup and applied to the account you're logged into. Uncheck Sync to let a setting stay different on each account." />
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ChangeSummary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource HexPrimaryButton}" Content="_Save" Command="{Binding SaveCommand}"
                    ToolTip="Save (Ctrl+S)" MinWidth="110" />
            <Button DockPanel.Dock="Right" Style="{StaticResource HexButton}" Content="Cancel" Command="{Binding CancelCommand}"
                    Margin="0,0,10,0" MinWidth="100" />
        </DockPanel>

        <!-- Validation message -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1,0,0,0" Padding="12,4" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSoftBrush}" />
        </Border>

        <!-- Hotkey hint -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                   Text="Hotkeys use League's format, for example [q], [Shift][1] or [Ctrl][Space]." />

        <!-- Tabs + search -->
        <Grid DockPanel.Dock="Top">
            <TabControl Style="{StaticResource HexTabControl}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate />
                </TabControl.ContentTemplate>
            </TabControl>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="200" Height="32" Margin="0,2,0,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource HexTextBox}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search settings" />
                <TextBlock Text="Search" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>

        <!-- Settings grid -->
        <Grid>
            <DataGrid x:Name="Grid" Style="{StaticResource HexDataGrid}" ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Sync" Width="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type editing:SettingRow}">
                                <CheckBox Style="{StaticResource HexCheckBox}" IsChecked="{Binding Sync, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" ToolTip="Sync this setting to every account"
                                          AutomationProperties.Name="{Binding Label, StringFormat=Sync {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Setting" Width="*" SortMemberPath="Label">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type editing:SettingRow}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding KeyText}">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" ToolTip="Changed" />
                                    <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Sync}" Value="False">
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Value" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type editing:SettingRow}">
                                <Grid>
                                    <CheckBox Style="{StaticResource HexToggle}" HorizontalAlignment="Left"
                                              IsChecked="{Binding Value, Converter={StaticResource StringToBool}, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="{Binding Label}" />
                                    <TextBox Style="{StaticResource HexTextBox}" Padding="6,2" FontSize="13" Height="26" VerticalAlignment="Center"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsBoolean, Converter={StaticResource InverseBoolToVisibility}}"
                                             AutomationProperties.Name="{Binding Label}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" MaxWidth="360"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</controls:HexWindow>
